DEPLOY_ENV=production
# Production uses no Cloudflare Tunnel: it sits behind its own reverse proxy (see README, Production)
COMPOSE_FILE=compose.yaml

# Both hostnames are served by production's reverse proxy; fgv-infra-deploy's .env names the API's SPEXIFY_API_HOST.
# Subsonic apps connect to API_HOST.
WEB_HOST=spexify.example.org
API_HOST=spexify-api.example.org
KEYCLOAK_HOST=auth.example.org
KEYCLOAK_REALM=fgv

API_IMAGE=bloomper/fgv-spexify-server:1.0.0
WEB_IMAGE=bloomper/fgv-spexify-web:1.0.0
MYSQL_IMAGE=mysql:8.4
NAVIDROME_IMAGE=deluan/navidrome:0.64.2
# The internal network between the API and Navidrome, /24; change it if it clashes with another network on the host
NAVIDROME_SUBNET_PREFIX=172.31.250

MYSQL_DATABASE=spexify
MYSQL_USER=spexify

SPEXREGISTER_GRAPHQL_URL=http://spexregister-api:8080/api/graphql
# Spexflix's GraphQL API on the shared network, for links to videos; empty without Spexflix
SPEXFLIX_GRAPHQL_URL=http://spexflix-api:8080/api/graphql
SPEXFLIX_WEB_URL=https://spexflix.example.org
SPEXREGISTER_WEB_URL=https://register.example.org
FGV_REVIVAL_WEB_URL=https://revival.example.org
SPEXGRAM_WEB_URL=https://spexgram.example.org
ARCHIVE_WEB_URL=https://archive.example.org
API_IMPORT_SAMPLE_DATA=false
API_SAMPLE_DATA_SIZE=small

SUPPORTED_LOCALES=sv,en
DEFAULT_LOCALE=sv
SUPPORT_EMAIL=support.spexify@example.org
FEEDBACK_EMAIL=feedback.spexify@example.org
UMAMI_WEBSITE_ID=
