DEPLOY_ENV=staging
COMPOSE_FILE=compose.yaml

# Spexify's hostname is served by the edge proxy in fgv-infra-deploy (compose.edge.yaml), DNS-only on Cloudflare
WEB_HOST=spexify-staging.example.org
KEYCLOAK_HOST=auth-staging.example.org
KEYCLOAK_REALM=fgv

API_IMAGE=bloomper/fgv-spexify-server:develop
WEB_IMAGE=bloomper/fgv-spexify-web:develop
MYSQL_IMAGE=mysql:8.4
NAVIDROME_IMAGE=deluan/navidrome:0.64.2
# The internal network between the API and Navidrome, /24; change it if it clashes with another network on the host
NAVIDROME_SUBNET_PREFIX=172.31.250

MYSQL_DATABASE=spexify
MYSQL_USER=spexify

SPEXREGISTER_GRAPHQL_URL=http://spexregister-api:8080/api/graphql
# Spexflix's GraphQL API on the shared network, for links to videos; empty without Spexflix
SPEXFLIX_GRAPHQL_URL=http://spexflix-api:8080/api/graphql
SPEXFLIX_WEB_URL=https://spexflix-staging.example.org
SPEXREGISTER_WEB_URL=https://register-staging.example.org
FGV_REVIVAL_WEB_URL=https://revival-staging.example.org
API_IMPORT_SAMPLE_DATA=true
API_SAMPLE_DATA_SIZE=small

SUPPORTED_LOCALES=sv,en
DEFAULT_LOCALE=sv
SUPPORT_EMAIL=support.spexify@example.org
FEEDBACK_EMAIL=feedback.spexify@example.org
UMAMI_WEBSITE_ID=
